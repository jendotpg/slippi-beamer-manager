{
  "compilerOptions": {
    "incremental": true,
    "target": "es2022",
    "module": "preserve",
    "lib": ["dom", "es2022"],
    "jsx": "react-jsx",
    "strict": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": ".erb/dll",
    "rootDir": ".",
    "types": ["node", "vite/client"]
  },
  "exclude": [
    "test",
    "release/build",
    "release/app/dist",
    ".erb/dll",
    "node_modules",
    ".erb/tooling/node_modules"
  ],
  "include": [
    "src",
    ".erb/configs",
    ".erb/scripts",
    "eslint.config.js",
    "electron.vite.config.ts"
  ]
}
